{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meo-mao-plush",
	"main": "worker.js",
	"compatibility_date": "2026-10-08",
	"assets": {
		"directory": ".cloudflare-assets",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": [
			"/api/*",
			"/"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "meo-mao-messages",
			"database_id": "c251bd9e-1ee4-4b95-b77a-de1ff4dd66e3"
		}
	]
}
